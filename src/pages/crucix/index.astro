---
import HomeSider from '@components/layout/HomeSider.astro';
import Cover from '@components/ui/cover/Cover.astro';
import { CONTENT_PADDING } from '@constants/layout';
import { siteConfig } from '@constants/site-config';
import Layout from '@layouts/Layout.astro';
import TwoColumnLayout from '@layouts/TwoColumnLayout.astro';

const title = `情报终端 | ${siteConfig.title}`;
const description =
  '开源情报仪表板：GitHub 趋势、地震、航天动态、CVE 漏洞、汇率、火箭发射、军事空域、自然灾害，数据由 GitHub Actions 每 30 分钟自动更新';
---

<Layout title={title} description={description}>
  <TwoColumnLayout showPostFooter={false}>
    <Cover slot="cover" title="情报终端" />
    <HomeSider slot="sider" />
    <div class={`bg-gradient-start shadow-box flex flex-col gap-6 ${CONTENT_PADDING.standard}`}>
      <div class="mt-4 flex flex-col gap-6">
        <!-- 状态栏 + 筛选 -->
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-2 text-muted-foreground text-sm" id="meta">
            <span class="inline-block h-2 w-2 animate-pulse rounded-full bg-primary/60"></span>
            正在载入数据源…
          </div>
          <div class="flex flex-wrap gap-2" id="filterBar">
            <button type="button" class="chip active" data-cat="all">全部</button>
            <button type="button" class="chip" data-cat="dev">开发</button>
            <button type="button" class="chip" data-cat="geo">地缘</button>
            <button type="button" class="chip" data-cat="space">航天</button>
            <button type="button" class="chip" data-cat="sec">安全</button>
            <button type="button" class="chip" data-cat="econ">经济</button>
            <button type="button" class="chip" data-cat="disaster">灾害</button>
          </div>
        </div>

        <!-- 面板网格 -->
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3" id="grid">
          <div class="col-span-full py-12 text-center text-muted-foreground text-sm">正在从本地数据源拉取…</div>
        </div>

        <p class="text-center text-muted-foreground text-xs leading-relaxed">
          数据源：GitHub · USGS · Spaceflight News · CISA KEV · ExchangeRate · Launch Library · Hacker News · NASA EONET · OpenSky · World Bank · WHO<br />
          由 GitHub Actions 每 30 分钟自动更新 ·
          <a href="https://github.com/QianChang-official/crucix_zh_repir" class="text-primary hover:underline">crucix_zh_repir</a>
        </p>
      </div>
    </div>
  </TwoColumnLayout>
</Layout>

<style>
  .chip {
    padding: 0.375rem 0.875rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    cursor: pointer;
    background: hsl(var(--muted) / 0.5);
    color: hsl(var(--muted-foreground));
    border: 1px solid hsl(var(--border));
    transition: all 0.2s;
  }
  .chip:hover { background: hsl(var(--muted)); color: hsl(var(--foreground)); }
  .chip.active {
    background: hsl(var(--primary) / 0.12);
    color: hsl(var(--primary));
    border-color: hsl(var(--primary) / 0.4);
  }
</style>

<script>
  const PANELS = [
    { id: 'github-trending', title: 'GitHub 趋势', cat: 'dev', render: renderGithub },
    { id: 'hacker-news', title: 'Hacker News 热榜', cat: 'dev', render: renderHN },
    { id: 'earthquakes', title: '全球地震 (24h M4.5+)', cat: 'disaster', render: renderQuakes },
    { id: 'usgs-significant', title: '显著地震 (7天)', cat: 'disaster', render: renderSigQuakes },
    { id: 'nasa-eonet', title: '自然灾害 (NASA EONET)', cat: 'disaster', render: renderEonet },
    { id: 'spaceflight-news', title: '航天动态', cat: 'space', render: renderSpace },
    { id: 'launches', title: '近期火箭发射', cat: 'space', render: renderLaunches },
    { id: 'opensky-military', title: '军事空域监控', cat: 'geo', render: renderOpensky },
    { id: 'cisa-kev', title: '在野利用漏洞 (CISA KEV)', cat: 'sec', render: renderKev },
    { id: 'exchange-rates', title: '美元汇率', cat: 'econ', render: renderRates },
    { id: 'worldbank-gdp', title: '全球 GDP 增长', cat: 'econ', render: renderGdp },
    { id: 'who-outbreaks', title: 'WHO 疫情爆发', cat: 'sec', render: renderWho },
  ];

  async function load(name) {
    const res = await fetch(`/crucix/data/${name}.json`);
    return res.json();
  }

  function fmtTime(iso) {
    if (!iso) return '';
    const d = new Date(iso);
    return d.toLocaleString('zh-CN', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
  }

  function esc(s) {
    return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function panel(p, bodyHtml, count) {
    return `
      <div class="panel rounded-xl border border-border/60 bg-card p-4 shadow-sm" data-cat="${p.cat}">
        <div class="mb-3 flex items-center justify-between">
          <span class="font-bold text-primary text-xs uppercase tracking-widest">${esc(p.title)}</span>
          ${count !== '' ? `<span class="text-muted-foreground text-xs">${count}</span>` : ''}
        </div>
        <div class="flex flex-col">${bodyHtml}</div>
      </div>`;
  }

  function item(html, sub) {
    return `<div class="border-border/40 border-b py-2 text-sm last:border-b-0">${html}${sub ? `<div class="mt-0.5 text-muted-foreground text-xs">${sub}</div>` : ''}</div>`;
  }

  function statRow(k, v) {
    return `<div class="flex items-center justify-between border-border/40 border-b py-2 text-sm last:border-b-0"><span class="text-muted-foreground">${k}</span><span class="font-medium text-foreground">${v}</span></div>`;
  }

  function renderGithub(j) {
    if (!j.ok) return `<div class="text-red-500 text-xs">抓取失败: ${esc(j.error)}</div>`;
    return j.data.map(r => item(
      `<a href="${esc(r.url)}" target="_blank" rel="noopener" class="font-medium text-foreground transition-colors hover:text-primary">${esc(r.name)}</a>`,
      `${r.desc ? esc(r.desc.slice(0, 70)) + ' · ' : ''}<span class="font-medium text-primary">★ ${r.stars.toLocaleString()}</span> ${esc(r.lang || '')}`
    )).join('');
  }

  function renderHN(j) {
    if (!j.ok) return `<div class="text-red-500 text-xs">抓取失败: ${esc(j.error)}</div>`;
    return j.data.map(it => item(
      `<a href="${esc(it.url || 'https://news.ycombinator.com/item?id=' + it.id)}" target="_blank" rel="noopener" class="text-foreground transition-colors hover:text-primary">${esc(it.title)}</a>`,
      `<span class="font-medium text-primary">▲ ${it.score}</span> by ${esc(it.by)}`
    )).join('');
  }

  function renderQuakes(j) {
    if (!j.ok) return `<div class="text-red-500 text-xs">抓取失败: ${esc(j.error)}</div>`;
    return j.data.map(q => item(
      `<a href="${esc(q.url)}" target="_blank" rel="noopener" class="text-foreground transition-colors hover:text-primary">${esc(q.place)}</a>`,
      `<span class="font-medium text-orange-500">M${q.mag}</span> · ${fmtTime(q.time)}`
    )).join('');
  }

  function renderSigQuakes(j) {
    if (!j.ok) return `<div class="text-red-500 text-xs">抓取失败: ${esc(j.error)}</div>`;
    if (!j.data.length) return `<div class="py-3 text-muted-foreground text-xs">过去 7 天无显著地震</div>`;
    return j.data.map(q => item(
      `<a href="${esc(q.url)}" target="_blank" rel="noopener" class="text-foreground transition-colors hover:text-primary">${esc(q.place)}</a>`,
      `<span class="font-medium text-orange-500">M${q.mag}</span>${q.tsunami ? ' <span class="font-medium text-red-500">海啸</span>' : ''} · ${fmtTime(q.time)}`
    )).join('');
  }

  function renderEonet(j) {
    if (!j.ok) return `<div class="text-red-500 text-xs">抓取失败: ${esc(j.error)}</div>`;
    return j.data.map(e => item(
      `<a href="${esc(e.link)}" target="_blank" rel="noopener" class="text-foreground transition-colors hover:text-primary">${esc(e.title)}</a>`,
      `${esc(e.category || '')} · ${fmtTime(e.updated)}`
    )).join('');
  }

  function renderSpace(j) {
    if (!j.ok) return `<div class="text-red-500 text-xs">抓取失败: ${esc(j.error)}</div>`;
    return j.data.map(a => item(
      `<a href="${esc(a.url)}" target="_blank" rel="noopener" class="text-foreground transition-colors hover:text-primary">${esc(a.title)}</a>`,
      fmtTime(a.published)
    )).join('');
  }

  function renderLaunches(j) {
    if (!j.ok) return `<div class="text-red-500 text-xs">抓取失败: ${esc(j.error)}</div>`;
    return j.data.map(l => item(
      `<span class="font-medium text-foreground">${esc(l.name)}</span>`,
      `${esc(l.provider || '')} · ${esc(l.location || '')} · ${fmtTime(l.net)}`
    )).join('');
  }

  function renderOpensky(j) {
    if (!j.ok) return `<div class="text-red-500 text-xs">抓取失败: ${esc(j.error)}</div>`;
    return j.data.map(r => statRow(
      esc(r.region),
      `${r.total} 架 <span class="font-medium text-sky-500">${r.military} 军机</span>`
    )).join('');
  }

  function renderKev(j) {
    if (!j.ok) return `<div class="text-red-500 text-xs">抓取失败: ${esc(j.error)}</div>`;
    return j.data.map(v => item(
      `<span class="font-mono font-medium text-red-500 text-xs">${esc(v.cve)}</span> <a href="https://nvd.nist.gov/vuln/detail/${esc(v.cve)}" target="_blank" rel="noopener" class="text-foreground transition-colors hover:text-primary">${esc(v.name)}</a>`,
      `${esc(v.vendor)} · ${esc(v.product)} · 加入 ${esc(v.added)}`
    )).join('');
  }

  function renderRates(j) {
    if (!j.ok) return `<div class="text-red-500 text-xs">抓取失败: ${esc(j.error)}</div>`;
    const items = Object.entries(j.data.rates).map(([c, r]) => statRow(c, r)).join('');
    return items + `<div class="mt-2 text-muted-foreground text-xs">更新: ${esc(j.data.updated || '')}</div>`;
  }

  function renderGdp(j) {
    if (!j.ok) return `<div class="text-red-500 text-xs">抓取失败: ${esc(j.error)}</div>`;
    return j.data.map(r => statRow(
      esc(r.year),
      `<span class="${r.value < 0 ? 'text-orange-500' : 'text-primary'}">${r.value !== null ? r.value + '%' : '—'}</span>`
    )).join('');
  }

  function renderWho(j) {
    if (!j.ok) return `<div class="text-red-500 text-xs">抓取失败: ${esc(j.error)}</div>`;
    return j.data.map(o => item(
      `<a href="${esc(o.url)}" target="_blank" rel="noopener" class="text-foreground transition-colors hover:text-primary">${esc(o.title)}</a>`,
      fmtTime(o.date)
    )).join('');
  }

  function setupFilter() {
    const bar = document.getElementById('filterBar');
    if (!bar) return;
    bar.addEventListener('click', (e) => {
      const btn = e.target.closest('.chip');
      if (!btn) return;
      bar.querySelectorAll('.chip').forEach(c => c.classList.remove('active'));
      btn.classList.add('active');
      const cat = btn.dataset.cat;
      document.querySelectorAll('.panel').forEach(p => {
        p.classList.toggle('hidden', cat !== 'all' && p.dataset.cat !== cat);
      });
    });
  }

  async function main() {
    const grid = document.getElementById('grid');
    if (!grid) return;
    grid.innerHTML = '';
    let metaOk = 0, metaTotal = 0, lastTime = '';
    for (const p of PANELS) {
      const j = await load(p.id);
      const count = j.ok && Array.isArray(j.data) ? j.data.length : '';
      grid.insertAdjacentHTML('beforeend', panel(p, p.render(j), count));
      metaTotal++;
      if (j.ok) { metaOk++; lastTime = j.fetchedAt || lastTime; }
    }
    const metaEl = document.getElementById('meta');
    if (metaEl) {
      const allOk = metaOk === metaTotal;
      metaEl.innerHTML =
        `<span class="inline-block h-2 w-2 rounded-full ${allOk ? 'bg-primary' : 'bg-red-500'}"></span>` +
        `${metaOk}/${metaTotal} 源正常 · 更新于 ${fmtTime(lastTime)}`;
    }
    setupFilter();
  }

  main();
</script>
