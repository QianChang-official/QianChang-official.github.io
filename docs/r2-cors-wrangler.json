{
  "rules": [
    {
      "allowed": {
        "origins": [
          "http://localhost:3000",
          "http://localhost:4173",
          "https://qianchanglys.top",
          "https://qianchang-official.github.io"
        ],
        "methods": [
          "GET",
          "HEAD"
        ],
        "headers": [
          "*"
        ]
      },
      "exposeHeaders": [
        "ETag",
        "Content-Length",
        "Content-Type"
      ],
      "maxAgeSeconds": 86400
    }
  ]
}
